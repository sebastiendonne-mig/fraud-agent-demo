    {
      "id": "topic-affichage-reason-codes-siu",
      "name": "Affichage Reason Codes (Agent SIU uniquement)",
      "trigger": {
        "type": "phrases",
        "phrases": ["voir le score", "raisons de l'alerte", "reason codes", "pourquoi alerte", "détails fraude"],
        "role_required": "agent_siu"
      },
      "nodes": [
        {
          "id": "n70",
          "type": "condition",
          "variable": "System.User.Role",
          "branches": [
            {
              "condition": "not_in(['agent_siu', 'superviseur', 'admin'])",
              "nodes": [
                {
                  "id": "n70a",
                  "type": "message",
                  "content": "Ces informations sont réservées aux agents SIU. Veuillez contacter votre responsable."
                },
                { "id": "n70b", "type": "end_conversation", "reason": "unauthorized" }
              ]
            }
          ]
        },
        {
          "id": "n71",
          "type": "question",
          "text": "Quel est le numéro du dossier dont vous souhaitez consulter les détails ? (format : SIN-YYYY-XXXX)",
          "variable": "local_id_sinistre_lookup",
          "entity": "StringPattern"
        },
        {
          "id": "n72",
          "type": "action",
          "action_id": "action-dataverse-get-police",
          "comment": "Rechargement du sinistre depuis Dataverse pour affichage SIU"
        },
        {
          "id": "n73",
          "type": "adaptive_card",
          "card_id": "card-siu-score-detail",
          "title": "🔍 Détail scoring — {local_id_sinistre_lookup}",
          "comment": "Carte réservée agents SIU — jamais affichée à l'assuré",
          "fields": [
            { "label": "Score fraude",      "value": "{gv_score_fraude} / 100" },
            { "label": "Score règles",      "value": "{gv_score_regles} / 50" },
            { "label": "Score ML",          "value": "{gv_score_ml} / 50" },
            { "label": "Catégorie",         "value": "{gv_categorie_risque}" },
            { "label": "Reason codes",      "value": "{gv_reason_codes}" },
            { "label": "IP déclaration",    "value": "{gv_adresse_ip}" },
            { "label": "IP sinistres 30j",  "value": "{gv_ip_count_30d}" },
            { "label": "Réparateur 90j",    "value": "{gv_reparateur_count_90d}" }
          ],
          "actions": [
            { "type": "button", "title": "Confirmer fraude",  "value": "fraude_confirmee" },
            { "type": "button", "title": "Clore sans suite",   "value": "clos_sans_suite" },
            { "type": "button", "title": "Escalader SIU",      "value": "escalade_siu" }
          ]
        },
        {
          "id": "n74",
          "type": "condition",
          "variable": "Activity.Value",
          "branches": [
            {
              "condition": "equals('fraude_confirmee')",
              "nodes": [
                {
                  "id": "n74a",
                  "type": "action",
                  "action_id": "action-dataverse-create-sinistre",
                  "override": { "cr_statut": "fraude_confirmee" }
                },
                { "id": "n74b", "type": "message", "content": "Dossier marqué comme fraude confirmée. Le signalement SIU a été mis à jour." }
              ]
            },
            {
              "condition": "equals('clos_sans_suite')",
              "nodes": [
                {
                  "id": "n74c",
                  "type": "action",
                  "action_id": "action-dataverse-create-sinistre",
                  "override": { "cr_statut": "clos_sans_suite" }
                },
                { "id": "n74d", "type": "message", "content": "Dossier clos sans suite. Transmission au circuit d'indemnisation standard." }
              ]
            }
          ]
        },
        { "id": "n75", "type": "end_conversation", "reason": "siu_action_taken" }
      ]
    },

    {
      "id": "topic-fallback-scoring",
      "name": "Fallback — Erreur Azure ML",
      "trigger": { "type": "sub_topic" },
      "nodes": [
        {
          "id": "n80",
          "type": "message",
          "content": "L'analyse automatique est temporairement indisponible. Votre dossier **{gv_id_sinistre}** est enregistré et transmis manuellement à notre équipe.",
          "comment": "Fallback conservateur : le dossier est créé en Dataverse avec score_fraude null — traitement manuel par SIU"
        },
        {
          "id": "n81",
          "type": "action",
          "action_id": "action-dataverse-create-sinistre",
          "override": {
            "cr_score_fraude": null,
            "cr_statut": "scoring_erreur",
            "cr_flag_fraude_suspect": true,
            "comment": "Flag suspect par précaution — un agent SIU traitera manuellement"
          }
        },
        {
          "id": "n82",
          "type": "action",
          "action_id": "action-teams-notif-siu",
          "comment": "Alerte Teams SIU pour traitement manuel — indique erreur scoring"
        },
        {
          "id": "n83",
          "type": "message",
          "content": "Un gestionnaire traitera votre dossier dans les 48h ouvrées. Référence : **{gv_id_sinistre}**."
        },
        { "id": "n84", "type": "end_conversation", "reason": "scoring_fallback" }
      ]
    },

    {
      "id": "topic-erreur-police-introuvable",
      "name": "Erreur — Police non trouvée",
      "trigger": { "type": "sub_topic" },
      "nodes": [
        {
          "id": "n90",
          "type": "message",
          "content": "Je n'ai pas trouvé de contrat actif avec le numéro **{gv_id_police}**. Veuillez vérifier votre numéro de police sur votre carte verte ou votre contrat."
        },
        {
          "id": "n91",
          "type": "question",
          "text": "Souhaitez-vous réessayer avec un autre numéro ou être mis en relation avec notre service client ?",
          "choices": ["Réessayer", "Service client"]
        },
        {
          "id": "n92",
          "type": "condition",
          "variable": "Activity.Value",
          "branches": [
            { "condition": "equals('Réessayer')",   "nodes": [{ "id": "n92a", "type": "redirect", "target_topic": "topic-saisie-sinistre" }] },
            { "condition": "equals('Service client')", "nodes": [
              { "id": "n92b", "type": "message", "content": "Je vous transfère vers notre service client : **0800 XXX XXX** (appel gratuit, lun–ven 8h–18h)." },
              { "id": "n92c", "type": "end_conversation", "reason": "escalate_human" }
            ]}
          ]
        }
      ]
    },

    {
      "id": "topic-gestion-erreurs",
      "name": "Gestion des erreurs — Fallback général",
      "trigger": {
        "type": "system",
        "events": ["OnError", "OnUnrecognized"],
        "max_unrecognized_retries": 2
      },
      "nodes": [
        {
          "id": "n95",
          "type": "message",
          "content": "Je n'ai pas pu traiter votre demande. Je vous transfère vers un agent humain."
        },
        {
          "id": "n96",
          "type": "end_conversation",
          "reason": "escalate_human",
          "transfer_to": "siu@assureur-demo.fr"
        }
      ]
    }
  ],

  "adaptive_cards": {
    "card-alerte-siu": {
      "description": "Carte Teams envoyée au canal SIU pour toute alerte score ≥ 30 — contient score, reason codes, lien dossier",
      "schema": "http://adaptivecards.io/schemas/adaptive-card.json",
      "version": "1.5",
      "body": [
