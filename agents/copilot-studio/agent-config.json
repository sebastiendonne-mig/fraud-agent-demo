          "content": "Vous recevrez un email de confirmation à l'adresse enregistrée sur votre contrat. Y a-t-il autre chose que je puisse faire pour vous ?"
        },
        {
          "id": "n42",
          "type": "end_conversation",
          "reason": "stp_completed"
        }
      ]
    },

    {
      "id": "topic-investigation-moyen",
      "name": "Investigation — Risque Moyen (score 30–59)",
      "trigger": { "type": "sub_topic" },
      "nodes": [
        {
          "id": "n50",
          "type": "message",
          "content": "Votre déclaration **{gv_id_sinistre}** a bien été enregistrée. En raison de certains éléments, votre dossier fait l'objet d'une vérification documentaire complémentaire."
        },
        {
          "id": "n51",
