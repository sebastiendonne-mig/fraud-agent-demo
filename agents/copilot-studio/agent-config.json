        {
          "id": "n55",
          "type": "end_conversation",
          "reason": "investigation_initiated"
        }
      ]
    },

    {
      "id": "topic-alerte-siu-eleve",
      "name": "Alerte SIU — Risque Élevé (score ≥ 60)",
      "trigger": { "type": "sub_topic" },
      "nodes": [
        {
          "id": "n60",
          "type": "message",
          "content": "Votre déclaration **{gv_id_sinistre}** a bien été enregistrée. Notre service de gestion des sinistres va examiner votre dossier en priorité."
        },
        {
          "id": "n61",
          "type": "action",
          "action_id": "action-pa-trigger-synapse",
          "comment": "Déclenche Agent 3 (Synapse) asynchrone — analyse réseau prioritaire"
        },
        {
          "id": "n62",
          "type": "action",
          "action_id": "action-pa-trigger-openai",
          "comment": "Déclenche Agent 4 (Azure OpenAI) si rapport de police disponible — asynchrone"
        },
        {
          "id": "n63",
          "type": "action",
          "action_id": "action-teams-notif-siu",
          "comment": "Notification Teams prioritaire au canal SIU — carte enrichie avec score et reason codes"
        },
        {
          "id": "n64",
          "type": "adaptive_card",
          "card_id": "card-confirmation-prioritaire",
          "title": "📋 Dossier transmis en traitement prioritaire",
          "body": "Votre dossier a été transmis à notre équipe spécialisée. Un gestionnaire vous contactera directement dans un délai de 24h ouvrées pour faire le point sur votre situation.",
          "fields": [
            { "label": "Référence dossier", "value": "{gv_id_sinistre}" },
            { "label": "Statut",            "value": "Traitement prioritaire" },
            { "label": "Délai de contact",  "value": "24h ouvrées" },
