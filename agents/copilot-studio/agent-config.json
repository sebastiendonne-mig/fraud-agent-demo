  "_metadata": {
    "version": "1.0.0",
    "created": "2026-06-04",
    "author": "Sébastien Donné — tkoidra.com",
    "project": "fraud-agent-demo",
    "agent_position": "Agent 1 / 5",
    "description": "Agent Copilot Studio orchestrateur — point d'entrée du pipeline de détection fraude & recours. Collecte les données du sinistre, enrichit via Dataverse (_reparateur_count_90d, _ip_count_30d), appelle score_single() sur Azure ML en temps réel, puis route selon le score : STP (< 30), investigation (30–59), alerte SIU (≥ 60).",
    "pipeline_integration": {
      "agent_1_this": "Copilot Studio — orchestration, saisie, routing",
      "agent_2_scoring": "Azure ML — scoring-model.py score_single() — endpoint https://aml-fraude-demo.azureml.azure.com/score",
      "agent_3_graph": "Azure Synapse — graph-query.sql vw_graph_alerts — déclenché via Power Automate asynchrone",
      "agent_4_openai": "Azure OpenAI GPT-4o — prompts analyse-rapport-police.md + identification-tiers.md — déclenché si score ≥ 60",
      "agent_5_recours": "Power Automate — flow-recours.json — déclenché si recours_possible = true dans Dataverse"
    },
    "scoring_contract": {
      "function": "score_single(sinistre: dict, police: dict, model_dir: str) -> dict",
      "required_sinistre_fields": ["id_sinistre", "id_police", "date_declaration", "type", "montant_reclame", "id_reparateur", "adresse_ip_declaration", "_reparateur_count_90d", "_ip_count_30d"],
      "required_police_fields": ["id_police", "date_souscription", "franchise", "plafond_garantie", "type_contrat"],
      "enrichment_fields": {
        "_reparateur_count_90d": "Nb sinistres vers même id_reparateur sur 90j — requête Dataverse avant appel",
        "_ip_count_30d": "Nb sinistres depuis même adresse_ip_declaration sur 30j — requête Dataverse avant appel"
      },
      "output_fields": ["score_fraude (0-100)", "score_ml (0-50)", "score_regles (0-50)", "categorie_risque (Faible|Moyen|Élevé)", "reason_codes (list)"],
      "routing_thresholds": {
        "stp": "score_fraude < 30",
        "investigation": "30 ≤ score_fraude < 60",
        "alerte_siu": "score_fraude ≥ 60"
      }
    },
    "topics_summary": {
      "topic-accueil": "Accueil, capture IP session, redirect vers saisie",
      "topic-saisie-sinistre": "Collecte interactive : police, type, date, montant, réparateur — validation entités — récap carte adaptative",
      "topic-enrichissement-scoring": "Requêtes Dataverse _reparateur_count_90d + _ip_count_30d → appel AzureML score_single() → persist Dataverse",
      "topic-routing-score": "Branch score < 30 → stp | 30–59 → investigation | ≥ 60 → alerte_siu",
      "topic-stp-faible-risque": "Confirmation assuré — circuit standard — 5j ouvrés",
      "topic-investigation-moyen": "Demande documents — alerte Synapse asynchrone — notif Teams SIU — 48h ouvrées",
      "topic-alerte-siu-eleve": "Alerte Synapse + OpenAI asynchrones — notif Teams SIU prioritaire — 24h ouvrées",
      "topic-affichage-reason-codes-siu": "Consultation dossier par agent SIU (role-gated) — score détaillé — actions confirmer/clore/escalader",
      "topic-fallback-scoring": "Erreur Azure ML — création sinistre avec statut scoring_erreur — flag suspect — notif manuelle SIU",
      "topic-erreur-police-introuvable": "Police inconnue — retry ou transfert service client",
      "topic-gestion-erreurs": "Fallback général OnError/OnUnrecognized — transfert humain"
    },
    "prerequisites": [
      "App Copilot Studio créée dans l'environnement fraude-agent-demo (Power Platform)",
      "Authentification Azure AD configurée avec app registration (client_id, tenant_id)",
      "Connexion Dataverse liée (cr_sinistres, cr_polices — droits Read/Write)",
      "Azure ML managed online endpoint déployé : https://aml-fraude-demo.azureml.azure.com/score (deployment: fraud-scoring-v1)",
      "Managed Identity du bot avec rôle AzureML Data Scientist sur le workspace ML",
      "Flow Power Automate flow-synapse-graph-analysis créé et publié (Agent 3)",
      "Flow Power Automate flow-openai-rapport-police créé et publié (Agent 4)",
      "Canal Teams configuré avec App ID enregistré dans Azure AD",
      "Canal Webchat DirectLine token endpoint sécurisé (jamais de secret hardcodé côté client)"
    ]
  }
}
